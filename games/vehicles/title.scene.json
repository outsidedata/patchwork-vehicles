{
  "extends": "desert.partial_scene.json",
  "world": {
    "terrain3d": { "preload": true },
    "loader": {
      "mods": { "shaders": "render3d", "ready": ["terrain3d"] },
      "assets": {
        "splash": { "type": "texture", "url": "/games/vehicles/assets/loading/splash.webp", "for": "ui", "preload": true },
        "Saira Condensed": { "type": "font", "url": "/games/vehicles/assets/title/SairaCondensed-ExtraBold.ttf" },
        "vehicles": { "type": "json", "url": "/games/vehicles/assets/vehicles.json", "preload": true },
        "effects": { "type": "json", "url": "/games/vehicles/assets/effects.json", "preload": true },
        "smoke": { "type": "sheet", "url": "/games/vehicles/assets/smoke.json", "preload": true },
        "desert": { "type": "json", "url": "/games/vehicles/assets/desert.json", "preload": true },
        "title": { "type": "model", "url": "/games/vehicles/assets/title/title.glb", "preload": true },
        "jeep-engine": { "type": "json", "url": "/games/vehicles/assets/sounds/jeep.engine.json" },
        "kit-looks": { "type": "json", "url": "/games/vehicles/assets/kit.looks.json", "preload": true },
        "jeep-body": { "type": "binary", "url": "/games/vehicles/assets/jeep/body.kit.glb" },
        "jeep-body-looks": { "type": "json", "url": "/games/vehicles/assets/jeep/body.kit.looks.json", "preload": true },
        "jeep-wheel-left": { "type": "binary", "url": "/games/vehicles/assets/jeep/wheel-left.kit.glb" },
        "jeep-wheel-left-looks": { "type": "json", "url": "/games/vehicles/assets/jeep/wheel-left.kit.looks.json", "preload": true },
        "jeep-wheel-right": { "type": "binary", "url": "/games/vehicles/assets/jeep/wheel-right.kit.glb" },
        "jeep-wheel-right-looks": { "type": "json", "url": "/games/vehicles/assets/jeep/wheel-right.kit.looks.json", "preload": true },
        "jeep-hub-front-left": { "type": "binary", "url": "/games/vehicles/assets/jeep/hub-front-left.kit.glb" },
        "jeep-hub-front-left-looks": { "type": "json", "url": "/games/vehicles/assets/jeep/hub-front-left.kit.looks.json", "preload": true },
        "jeep-hub-front-right": { "type": "binary", "url": "/games/vehicles/assets/jeep/hub-front-right.kit.glb" },
        "jeep-hub-front-right-looks": { "type": "json", "url": "/games/vehicles/assets/jeep/hub-front-right.kit.looks.json", "preload": true },
        "jeep-hub-rear-left": { "type": "binary", "url": "/games/vehicles/assets/jeep/hub-rear-left.kit.glb" },
        "jeep-hub-rear-left-looks": { "type": "json", "url": "/games/vehicles/assets/jeep/hub-rear-left.kit.looks.json", "preload": true },
        "jeep-hub-rear-right": { "type": "binary", "url": "/games/vehicles/assets/jeep/hub-rear-right.kit.glb" },
        "jeep-hub-rear-right-looks": { "type": "json", "url": "/games/vehicles/assets/jeep/hub-rear-right.kit.looks.json", "preload": true },
        "pedestrian-rig": {
          "type": "json",
          "url": "/games/vehicles/assets/pedestrian/pedestrian.rig.json",
          "preload": true
        },
        "sand": {
          "type": "texture",
          "url": "/games/vehicles/assets/ground/sand-color-1024.webp",
          "wrap": "repeat",
          "anisotropy": 8
        },
        "sandNormal": {
          "type": "texture",
          "url": "/games/vehicles/assets/ground/sand-normal-1024.webp",
          "space": "linear",
          "wrap": "repeat",
          "anisotropy": 8
        }
      }
    },
    "audio": {
      "hold": 0.25,
      "space": { "model": "inverse", "ref": 4, "max": 250, "rolloff": 1 },
      "cues": {},
      "volume": { "level": "volume", "muted": "silent" }
    },
    "shipped": { "plugins": ["interface"] },
    "ui3d": {
      "overlay": [0.1, 200],
      "keys": {
        "next": ["ArrowDown", "s"],
        "previous": ["ArrowUp", "w"],
        "press": ["Enter", " "]
      },
      "mods": { "behaviors": ["interface"] }
    },
    "ui": {
      "mods": { "behaviors": ["loader"] },
      "panels": {
        "loading": {
          "anchor": "center",
          "size": [1280, 720],
          "layer": 100,
          "modal": true,
          "loading": {
            "fill": { "color": 1841168 },
            "pictures": [{ "picture": "splash", "at": [0, 0], "size": [1280, 720] }],
            "bar": {
              "at": [340, 560],
              "size": [600, 14],
              "edge": 2,
              "frame": { "color": 15921906 },
              "track": { "color": 2830134 },
              "fill": { "color": 14693932 }
            },
            "lines": {
              "style": "loading.tip",
              "at": [640, 620],
              "every": 4,
              "text": ["Press Tab to move to the next free car.", "Press L for the headlights.", "Press Escape to choose where to drive.", "Space brakes; hold the down arrow to reverse."]
            },
            "shaders": { "style": "loading.tip", "at": [640, 620], "text": "Compiling shaders" },
            "fade": 0.8
          }
        }
      },
      "keys": {
        "up": ["ArrowUp", "w", "Pad12", "PadStickUp"],
        "down": ["ArrowDown", "s", "Pad13", "PadStickDown"],
        "left": ["ArrowLeft", "a", "Pad14", "PadStickLeft"],
        "right": ["ArrowRight", "d", "Pad15", "PadStickRight"],
        "press": ["Enter", " ", "Pad0"],
        "back": ["Escape", "Pad1", "Pad9"]
      },
      "styles": {
        "loading.tip": { "fontFamily": "Saira Condensed, Helvetica Neue, Arial, sans-serif", "fontSize": 28, "fill": 15921906 }
      }
    }
  },
  "plugins": [
    "loader",
    "scenemanager",
    "terrain3d",
    "skydome3d",
    "box3d",
    "supershader3d",
    "box3dvehicle",
    "particle3d",
    "ui3d",
    "render3d",
    "store",
    "audio",
    "ui",
    "shipped"
  ],
  "prefabs": {
    "store": { "volume": 1, "silent": true },
    "marquee": {},
    "driver": {
      "name": "",
      "vehicle": "",
      "route": "",
      "next": 0,
      "x": 0,
      "z": 0,
      "turn": 0,
      "made": 0,
      "pos": [0, 0, 0],
      "yaw": 0,
      "initialVelocity": [0, 0, 0]
    }
  },
  "actors": [
    { "is": "marquee" },
    {
      "is": "driver",
      "name": "jeep",
      "vehicle": "jeep",
      "route": "dunes",
      "next": 1,
      "x": -70,
      "z": -30,
      "turn": 0,
      "initialVelocity": [14, 0, 0]
    }
  ]
}
